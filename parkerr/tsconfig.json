{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./app/components/*"],
      "@/constants": ["./app/constants/index"],
      "@/constants/*": ["./app/constants/*"],
      "@/lib/*": ["./app/lib/*"],
      "@/store": ["./app/store/index"],
      "@/store/*": ["./app/store/*"],
      "@/types/*": ["./types/*"],
      "@/app/types/*": ["./types/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "types/**/*.d.ts"
  ]
}
